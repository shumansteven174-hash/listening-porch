# Copy this file to .env for local development. Never commit a real .env.
# On Render, set these as environment variables in the dashboard instead.

# Long random string used to sign session cookies. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the app listens on. Render sets PORT automatically; leave unset there.
PORT=3000

# Where the SQLite database file lives. Defaults to data/porch.db.
DATABASE_PATH=data/porch.db

# Comma-separated member handles that can review reports and hide content.
# Example: ADMIN_HANDLES=PorchTeam,Steven
ADMIN_HANDLES=

# Set to production on the live host.
NODE_ENV=development
